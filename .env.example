# Local development only. Production must use separate credentials and TLS.
POSTGRES_DB=canvas
POSTGRES_USER=canvas
POSTGRES_PASSWORD=canvas_dev_only
POSTGRES_PORT=55432
DATABASE_URL=postgres://canvas:canvas_dev_only@127.0.0.1:55432/canvas

BIND_ADDR=127.0.0.1:3000
# Local convenience only. Production uses separate canvas-migrate / restricted app role.
DATABASE_MIGRATE_ON_START=true
DATABASE_REQUIRE_RUNTIME_ROLE=false
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=5000
RUST_LOG=info

STROKE_MAX_POINTS=2000
# Maximum point-cloud span on either axis, before brush padding.
STROKE_MAX_SPAN=100000

# Exact browser origins, comma-separated, no paths or trailing slashes.
# Set the HTTPS application origin before deploying behind a reverse proxy.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
WS_MAX_CONNECTIONS=256
WS_MAX_MESSAGE_BYTES=131072
MUTATION_QUEUE_CAPACITY=128
EVENT_BUFFER_CAPACITY=256
SNAPSHOT_PAGE_SIZE=100
SNAPSHOT_CHUNK_BYTES=262144
VIEWPORT_MAX_SPAN=30000
WS_CREATES_PER_SECOND=5
WS_DELETES_PER_SECOND=20
WS_SUBSCRIBES_PER_SECOND=5
WS_MESSAGES_PER_SECOND=100
WS_HELLO_TIMEOUT_MS=5000
WS_SEND_TIMEOUT_MS=5000
WS_OPERATION_TIMEOUT_MS=10000
SNAPSHOT_TIMEOUT_MS=30000
WS_HEARTBEAT_INTERVAL_MS=20000
WS_IDLE_TIMEOUT_MS=60000
SPAWN_REFRESH_MS=30000

# Admin API is opt-in. Password + UV-required WebAuthn passkeys (Touch ID supported).
# No attestation CA file or hardware-key certificate is required.
ADMIN_ENABLED=false
# ADMIN_ORIGIN=https://endlessdrawing.com
# ADMIN_RP_ID=endlessdrawing.com
# For HTTPS local development use a separate localhost RP and test credentials.

# Uncomment when a Vite production build is available. Relative to the working directory.
# STATIC_DIR=../endless-drawing-frontend/dist
