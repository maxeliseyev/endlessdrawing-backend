# Separate from runtime.env; contains no DB credentials, passwords or private keys.
ENDLESSDRAWING_SITE=endlessdrawing.com
ENDLESSDRAWING_UPSTREAM=127.0.0.1:8080
# Default DENIES all external users. Replace only after reviewing DNS/proxy and operator IP.
ENDLESSDRAWING_ALLOWED_IPS="127.0.0.1/32 ::1/128"
