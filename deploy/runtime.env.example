# Server-only file: /etc/endlessdrawing/runtime.env, root:root, mode 0600.
# bootstrap.sh generates random values on the VPS. Do not use these placeholders.
POSTGRES_DB=canvas
POSTGRES_USER=canvas
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
DATABASE_URL=postgres://canvas:REPLACE_WITH_RANDOM_HEX_PASSWORD@postgres:5432/canvas

# Closed staging reached through an SSH tunnel to loopback port 8080.
# Before public deployment, replace with the exact HTTPS application origin.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
RUST_LOG=info

# Opt-in only after HTTPS/admin entry are ready. Never put passwords/passkeys in this file.
ADMIN_ENABLED=false
ADMIN_ORIGIN=https://endlessdrawing.com
ADMIN_RP_ID=endlessdrawing.com
