[Unit]
Description=Endless Drawing moderation report notices to Telegram (counts only)
After=network-online.target docker.service
Wants=network-online.target
ConditionPathExists=/etc/endlessdrawing/alerts.env

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/endlessdrawing-monitor reports
TimeoutStartSec=30
Nice=10
MemoryMax=64M
CPUQuota=10%
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/endlessdrawing-monitor
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
