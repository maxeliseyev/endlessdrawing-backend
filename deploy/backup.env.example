# /etc/endlessdrawing/backup.env — root:root 0600. Parsed as data, NEVER sourced as shell.
# Create a NEW Storage Box subaccount chrooted to a NEW real directory: endlessdrawing.
# The existing construct account/directory and its cron remain untouched.
BACKUP_AGE_RECIPIENT=REPLACE_WITH_PUBLIC_AGE_RECIPIENT
BACKUP_SSH_HOST=u12345-sub1.your-storagebox.de
BACKUP_SSH_USER=u12345-sub1
BACKUP_SSH_PORT=23
# Relative to the subaccount's chroot. Other values (including construct or ../) are rejected.
BACKUP_REMOTE_DIR=backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_SSH_IDENTITY_FILE=/etc/endlessdrawing/backup/id_ed25519
BACKUP_SSH_KNOWN_HOSTS_FILE=/etc/endlessdrawing/backup/known_hosts
